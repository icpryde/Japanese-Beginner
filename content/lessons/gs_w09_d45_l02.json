  "html": "<div class=\"fr-view\"><h3>Day 45 Lesson 2 - Grammar Slides</h3><div id=\"viewer-gs_w09_d45_l02\" class=\"grammar-slide-viewer\"><img src=\"../../images/gs_w09_d45_l02_p01.jpg\" class=\"gs-page\" data-page=\"1\" style=\"display:block; max-width:100%; margin:0 auto;\" /><img src=\"../../images/gs_w09_d45_l02_p02.jpg\" class=\"gs-page\" data-page=\"2\" style=\"display:none; max-width:100%; margin:0 auto;\" /><div style=\"display:flex; gap:10px; align-items:center; justify-content:center; margin-top:12px;\"><button type=\"button\" class=\"gs-prev\">Prev</button><span class=\"gs-counter\">1 / 2</span><button type=\"button\" class=\"gs-next\">Next</button></div></div><div style=\"margin-top:14px; text-align:center;\"><div class=\"gs-audio-slot\" data-audio-idx=\"0\" style=\"margin:10px 0; display:none;\"><div style=\"font-size:12px; color:#94a3b8; margin-bottom:4px;\">Slide 2/2</div><audio controls preload=\"metadata\" src=\"../audio/gs_w09_d45_l02_a01.m4a\"></audio></div><div class=\"gs-audio-slot\" data-audio-idx=\"1\" style=\"margin:10px 0; display:block;\"><div style=\"font-size:12px; color:#94a3b8; margin-bottom:4px;\">Slide 1/2</div><audio controls preload=\"metadata\" src=\"../audio/gs_w09_d45_l02_a02.m4a\"></audio></div></div><script>(function(){  const root=document.getElementById('viewer-gs_w09_d45_l02');  if(!root){return;}  const pages=Array.from(root.querySelectorAll('.gs-page'));  if(!pages.length){return;}  const prev=root.querySelector('.gs-prev');  const next=root.querySelector('.gs-next');  const counter=root.querySelector('.gs-counter');  let idx=0;  function render(){    pages.forEach((p,i)=>{p.style.display = i===idx ? 'block' : 'none';});    counter.textContent = `${idx+1} / ${pages.length}`;    prev.disabled = idx===0;    next.disabled = idx===pages.length-1;  }  prev.addEventListener('click', ()=>{if(idx>0){idx-=1; render();}});  next.addEventListener('click', ()=>{if(idx<pages.length-1){idx+=1; render();}});  const doc=root.closest('.fr-view')||document;  const slots=Array.from(doc.querySelectorAll('.gs-audio-slot'));  const pageToAudio=[1, 0];  function updateAudio(){    if(!slots.length){return;}    const want=String(pageToAudio[idx] ?? 0);    slots.forEach(s=>{      const show = s.dataset.audioIdx === want;      s.style.display = show ? 'block' : 'none';      if(!show){ const a=s.querySelector('audio'); if(a && !a.paused){ a.pause(); } }    });  }  const _render = render;  render = function(){ _render(); updateAudio(); };  render();})();</script></div>",
